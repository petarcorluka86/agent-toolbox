# ---- Required: GitHub -----------------------------------------------------
# The repo that `review-pr` watches for PRs awaiting your review.
export GH_ORG="your-github-org"
export GH_REPO="your-repo-name"
export GH_USERNAME="your-github-username"

# ---- Optional: YouTrack ---------------------------------------------------
# Leave blank to run GitHub-only: `ad-hoc-pr` then just opens a PR with no
# ticket, and `review-pr` skips the linked-ticket lookup. To turn the
# integration on, URL + TOKEN + PROJECT_ID are the minimum.
export YOUTRACK_URL=""
export YOUTRACK_TOKEN=""
export YOUTRACK_PROJECT_ID=""
export YOUTRACK_USERNAME=""

# Optional even when YouTrack is on. Set both halves of a pair, or neither —
# a half-set pair is skipped rather than sent as a malformed field.
export YOUTRACK_TASK_TYPE_ID=""
export YOUTRACK_TASK_TYPE_NAME=""
export YOUTRACK_TAG_ID=""
export YOUTRACK_TAG_NAME=""

# ---- Optional: staging ----------------------------------------------------
# Adds a https://<branch>.<domain> link to the PR body. Blank = no link.
export STAGING_DOMAIN=""
